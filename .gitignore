# Local machine and editor state
.DS_Store
.AppleDouble
._*
.idea/
.vscode/
.claude/
*.swp
*.swo

# Secrets must never be committed
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*credentials*.json
*cookies*.json
*storage-state*.json
*storageState*.json
docs/local/

# Instructor materials remain local unless redistribution is explicitly cleared.
materials/instructor/

# Rebuildable tool/runtime caches, not the frozen TTS cache used by V13
.venv/
node_modules/
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.gitnexus/
renders/
build/
dist/
cache/
tmp/
remotion/public/
remotion/public_gfx/
remotion/src/data/film.json
remotion/out/
remotion/build/

# Old/offline transfer packages have no place in production source.
*.zip
*.7z
*.tar
*.tar.gz
*.log
